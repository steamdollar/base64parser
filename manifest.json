{
  "manifest_version": 3,
  "name": "Dev Toolkit",
  "version": "1.2",
  "description": "A powerful toolkit for Base64 encoding/decoding and HTTP API requests.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "libs/mermaid.min.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon48.png"
    }
  },
  "icons": {
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "commands": {
    "decode-base64": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Decode Base64"
    },
    "show-mermaid": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Show Mermaid Chart Overlay"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate selected text"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/mermaid.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}