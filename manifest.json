{
  "manifest_version": 3,
  "name": "Dev Toolkit",
  "version": "1.3",
  "description": "A powerful toolkit for Base64 encoding/decoding and HTTP API requests.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "libs/mermaid.min.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon48.png"
    }
  },
  "icons": {
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "commands": {
    "decode-base64": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Decode Base64"
    },
    "show-mermaid": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Show Mermaid Chart Overlay"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate selected text"
    },
    "save-memo": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save selected text as memo"
    },
    "move-tab-to-1": {
      "description": "Move current tab to position 1"
    },
    "move-tab-to-2": {
      "description": "Move current tab to position 2"
    },
    "move-tab-to-3": {
      "description": "Move current tab to position 3"
    },
    "move-tab-to-4": {
      "description": "Move current tab to position 4"
    },
    "move-tab-to-5": {
      "description": "Move current tab to position 5"
    },
    "move-tab-to-6": {
      "description": "Move current tab to position 6"
    },
    "move-tab-to-7": {
      "description": "Move current tab to position 7"
    },
    "move-tab-to-8": {
      "description": "Move current tab to position 8"
    },
    "move-tab-to-9": {
      "description": "Move current tab to position 9"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/mermaid.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}